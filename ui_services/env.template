# Copy this to .env.local and fill in values:
#   cp env.template .env.local

# ── Better Auth ──────────────────────────────────────
BETTER_AUTH_SECRET=change-me-to-a-random-64-char-string
BETTER_AUTH_URL=http://localhost:3000

# ── PostgreSQL (same as brain_midjab) ───────────────
DATABASE_URL=postgresql://admin:locationenabled@localhost:5432/midjab_v3

# ── FastAPI backend (use proxy so session cookie is sent) ───────────
# Leave unset to use same-origin /api/backend (recommended). Set to http://localhost:8000 only for direct API testing.
# NEXT_PUBLIC_API_URL=/api/backend
